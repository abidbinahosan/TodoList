@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Todo App</h1>

    <div class="mt-5">
        <a asp-action="Create" class="btn btn-primary btn-lg">
            <i class="bi bi-plus-circle"></i> Create New Todo
        </a>

        <div class="mt-3">
            <p>or</p>
            <a asp-controller="Todo" asp-action="Index" class="btn btn-outline-secondary">
                View Existing Todos
            </a>
        </div>
    </div>
</div>