@model IEnumerable<TodoList.Models.TodoItem>
@{
    ViewData["Title"] = "Todo List";
}

<h1>Todo List</h1>
<!-- ADD THIS PAGE SIZE DROPDOWN -->
<div class="row mb-3">
    <div class="col-md-3">
        <form asp-action="Index" method="get" class="form-inline">
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="pageSize" value="@ViewBag.PageSize" />
            <div class="input-group">
                <label class="input-group-text" for="pageSize">Items per page:</label>
                <select name="pageSize" class="form-select" onchange="this.form.submit()">
                    <option value="10" selected="@(ViewBag.PageSize == 10)">10</option>
                    <option value="25" selected="@(ViewBag.PageSize == 25)">25</option>
                    <option value="50" selected="@(ViewBag.PageSize == 50)">50</option>
                    <option value="100" selected="@(ViewBag.PageSize == 100)">100</option>
                </select>
            </div>
            <input type="hidden" name="page" value="1" />
        </form>
    </div>
</div>

<!-- Search Form -->
<form asp-action="Search" method="get" class="mb-4">
    <div class="row g-2">
        <div class="col-md-3">
            <input type="text" name="searchTerm" class="form-control"
                   value="@ViewBag.SearchTerm" placeholder="Search...">
        </div>
        <div class="col-md-2">
            <select name="isCompleted" class="form-select">
                <option value="">All Statuses</option>
                <option value="true" selected="@(ViewBag.IsCompleted == true)">Completed</option>
                <option value="false" selected="@(ViewBag.IsCompleted == false)">Pending</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="priority" class="form-select">
                <option value="">All Priorities</option>
                <option value="High" selected="@(ViewBag.Priority == "High")">High</option>
                <option value="Medium" selected="@(ViewBag.Priority == "Medium")">Medium</option>
                <option value="Low" selected="@(ViewBag.Priority == "Low")">Low</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
        <div class="col-md-2">
            <a asp-action="Index" class="btn btn-secondary w-100">Clear</a>
        </div>
    </div>
</form>

<!-- Todo Items Table -->
<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Title)</th>
            <th>@Html.DisplayNameFor(model => model.Description)</th>
            <th>@Html.DisplayNameFor(model => model.DueDate)</th>
            <th>@Html.DisplayNameFor(model => model.Priority)</th>
            <th>@Html.DisplayNameFor(model => model.IsCompleted)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Title)</td>
                <td>@Html.DisplayFor(modelItem => item.Description)</td>
                <td>@(item.DueDate?.ToShortDateString() ?? "-")</td>
                <td>
                    @if (item.Priority == "High")
                    {
                        <span class="badge bg-danger">@item.Priority</span>
                    }
                    else if (item.Priority == "Medium")
                    {
                        <span class="badge bg-warning">@item.Priority</span>
                    }
                    else if (item.Priority == "Low")
                    {
                        <span class="badge bg-success">@item.Priority</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">None</span>
                    }
                </td>
                <td>
                    @if (item.IsCompleted)
                    {
                        <span class="badge bg-success">Completed</span>
                    }
                    else
                    {
                        <span class="badge bg-warning">Pending</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    <form asp-action="ToggleComplete" method="post" style="display: inline;">
                        <input type="hidden" name="id" value="@item.Id" />
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm @(item.IsCompleted ? "btn-outline-warning" : "btn-outline-success")">
                            @(item.IsCompleted ? "Mark Pending" : "Mark Complete")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Pagination would go here if you implement it later -->
@{
    var totalPages = (int)Math.Ceiling((double)ViewBag.TotalCount / ViewBag.PageSize);
}

@if (totalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination">
            @if (ViewBag.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage - 1)"
                       asp-route-pageSize="@ViewBag.PageSize">
                        &laquo; Previous
                    </a>
                </li>
            }

            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-pageSize="@ViewBag.PageSize">
                        @i
                    </a>
                </li>
            }

            @if (ViewBag.CurrentPage < totalPages)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage + 1)"
                       asp-route-pageSize="@ViewBag.PageSize">
                        Next &raquo;
                    </a>
                </li>
            }
        </ul>
    </nav>
}